{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "catalog": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {},
          "configurations": {
            "production": { "target": "catalog:esbuild:production" },
            "development": { "target": "catalog:esbuild:development", "dev": true }
          },
          "defaultConfiguration": "production"
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/catalog",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["es-module-shims"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": []
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": { "target": "catalog:serve-original:development", "rebuildDelay": 0, "dev": true, "port": 4201 }
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": { "development": { "buildTarget": "catalog:esbuild:development" } },
          "defaultConfiguration": "development",
          "options": { "port": 4201 }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": { "tsConfig": "tsconfig.spec.json", "buildTarget": "catalog:esbuild:development" }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
